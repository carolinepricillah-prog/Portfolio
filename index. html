<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="The personal portfolio of Nassaka Caroline Pricillah, Software Engineering student and web developer.">
  <title>Nassaka Caroline Pricillah | Software Engineer</title>
  <style>
    :root {
      --bg: #090914;
      --surface: rgba(255,255,255,.065);
      --surface-strong: rgba(255,255,255,.10);
      --text: #f6f4ff;
      --muted: #b8b5ca;
      --purple: rgb(153, 92, 255);
      --cyan: rgb(0, 220, 255);
      --pink: rgb(255, 77, 190);
      --line: rgba(255,255,255,.13);
      --glow: 0 0 35px rgba(153,92,255,.22);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 88px; }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at 12% 12%, rgba(153,92,255,.16), transparent 30%),
        radial-gradient(circle at 88% 35%, rgba(0,220,255,.10), transparent 28%),
        radial-gradient(circle at 55% 90%, rgba(255,77,190,.08), transparent 30%),
        var(--bg);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    .container { width: min(1120px, 90%); margin: auto; }
    .gradient-text {
      background: linear-gradient(100deg, var(--cyan), var(--purple), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .section { padding: 100px 0; }
    .section-heading { text-align: center; margin-bottom: 48px; }
    .eyebrow {
      color: var(--cyan); text-transform: uppercase; letter-spacing: 3px;
      font-size: .78rem; font-weight: 700;
    }
    h2 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; margin-top: 10px; }
    .section-intro { max-width: 650px; margin: 14px auto 0; color: var(--muted); }

    /* Navigation */
    header {
      position: fixed; inset: 0 0 auto; z-index: 1000;
      background: rgba(9,9,20,.78); backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--line);
    }
    nav { min-height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 1.15rem; font-weight: 800; letter-spacing: .5px; }
    .logo span { color: var(--cyan); }
    .nav-links { display: flex; align-items: center; gap: 26px; list-style: none; }
    .nav-links a { color: var(--muted); font-size: .92rem; transition: color .25s ease; }
    .nav-links a:hover, .nav-links a.active { color: var(--cyan); }
    .menu-toggle {
      display: none; border: 1px solid var(--line); color: white;
      background: var(--surface); border-radius: 10px; padding: 8px 12px; cursor: pointer;
    }

    /* Buttons and cards */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 9px;
      padding: 13px 22px; border-radius: 999px; border: 1px solid transparent;
      font-weight: 700; cursor: pointer; transition: transform .25s, box-shadow .25s, background .25s;
    }
    .btn:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,220,255,.18); }
    .btn-primary { color: #080817; background: linear-gradient(100deg, var(--cyan), #9d7bff); }
    .btn-outline { border-color: rgba(0,220,255,.55); color: var(--text); background: rgba(0,220,255,.05); }
    .glass {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: 22px; backdrop-filter: blur(14px); box-shadow: var(--glow);
      transition: transform .3s ease, border-color .3s ease, background .3s ease;
    }
    .glass:hover { transform: translateY(-7px); border-color: rgba(0,220,255,.5); background: var(--surface-strong); }

    /* Hero */
    .hero { min-height: 100vh; display: grid; align-items: center; padding: 130px 0 75px; position: relative; }
    .hero-grid { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 55px; }
    .status {
      display: inline-flex; align-items: center; gap: 9px; padding: 8px 13px;
      border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
      background: var(--surface); font-size: .82rem; margin-bottom: 23px;
    }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #45f3ae; box-shadow: 0 0 12px #45f3ae; }
    .hero h1 { font-size: clamp(2.8rem, 7vw, 5.4rem); line-height: 1.04; letter-spacing: -2px; }
    .hero h1 span { display: block; }
    .hero h3 { margin: 20px 0 13px; font-size: clamp(1.15rem, 2.5vw, 1.55rem); color: #d8d3f2; font-weight: 500; }
    .hero p { color: var(--muted); max-width: 620px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
    .hero-note { margin-top: 22px; font-size: .85rem; color: #918ca8; }
    .orbit-wrap { min-height: 390px; display: grid; place-items: center; position: relative; }
    .orbit {
      width: min(340px, 75vw); aspect-ratio: 1; border-radius: 50%;
      display: grid; place-items: center; position: relative;
      border: 1px solid rgba(0,220,255,.25);
      background: radial-gradient(circle, rgba(153,92,255,.22), rgba(0,220,255,.04) 55%, transparent 70%);
      box-shadow: 0 0 70px rgba(153,92,255,.16), inset 0 0 55px rgba(0,220,255,.08);
      animation: float 6s ease-in-out infinite;
    }
    .orbit::before, .orbit::after {
      content: ""; position: absolute; inset: 10%; border: 1px solid rgba(255,77,190,.35);
      border-radius: 50%; transform: rotateX(65deg) rotateZ(25deg);
    }
    .orbit::after { inset: -3%; border-color: rgba(0,220,255,.28); transform: rotateX(65deg) rotateZ(-35deg); }
    .orbit-core {
      width: 145px; height: 145px; border-radius: 35px; display: grid; place-items: center;
      font-size: 3.5rem; font-weight: 900; color: white;
      background: linear-gradient(145deg, rgba(153,92,255,.8), rgba(0,220,255,.5));
      border: 1px solid rgba(255,255,255,.4); box-shadow: 0 0 50px rgba(153,92,255,.5);
      transform: rotate(-8deg);
    }
    .orbit-tag {
      position: absolute; padding: 8px 13px; border-radius: 12px; font-size: .8rem;
      background: rgba(15,15,34,.88); border: 1px solid var(--line); color: #e8e4ff;
    }
    .tag-one { top: 12%; right: -3%; }
    .tag-two { bottom: 15%; left: -5%; }
    .tag-three { bottom: 4%; right: 10%; }
    @keyframes float { 0%,100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-13px) rotate(2deg); } }

    /* About */
    .about-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 28px; align-items: stretch; }
    .about-highlight { padding: 32px; display: flex; flex-direction: column; justify-content: center; }
    .about-mark {
      width: 74px; height: 74px; display: grid; place-items: center; border-radius: 22px;
      font-size: 2rem; margin-bottom: 22px; color: var(--cyan);
      background: linear-gradient(135deg, rgba(0,220,255,.18), rgba(153,92,255,.22));
      border: 1px solid rgba(0,220,255,.25);
    }
    .about-copy { padding: 32px; }
    .about-copy p { color: var(--muted); margin: 13px 0; }
    .facts { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-top: 22px; }
    .fact { padding: 14px; border-radius: 13px; background: rgba(255,255,255,.045); border: 1px solid var(--line); }
    .fact strong { display: block; color: var(--cyan); font-size: .85rem; }
    .fact span { color: var(--muted); font-size: .88rem; }

    /* Skills */
    .skills-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
    .skill-card { padding: 23px; }
    .skill-top { display: flex; align-items: center; gap: 13px; margin-bottom: 14px; }
    .skill-icon {
      width: 43px; height: 43px; display: grid; place-items: center; border-radius: 13px;
      color: var(--cyan); font-weight: 800; background: rgba(0,220,255,.1); border: 1px solid rgba(0,220,255,.2);
    }
    .skill-card p { color: var(--muted); font-size: .88rem; }
    .skill-line { height: 5px; background: rgba(255,255,255,.09); border-radius: 20px; margin-top: 17px; overflow: hidden; }
    .skill-line span { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--purple), var(--cyan), var(--pink)); transition: width 1.2s ease; }

    /* Projects and services */
    .projects-grid, .services-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
    .project-card, .service-card { padding: 25px; }
    .project-visual {
      min-height: 145px; border-radius: 16px; margin-bottom: 20px; display: grid; place-items: center;
      font-size: 2.8rem; color: var(--cyan);
      background: radial-gradient(circle at 25% 25%, rgba(0,220,255,.22), transparent 45%), linear-gradient(135deg, rgba(153,92,255,.2), rgba(255,77,190,.12));
      border: 1px solid var(--line);
    }
    .project-card p, .service-card p { color: var(--muted); font-size: .91rem; margin: 10px 0 16px; }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tags span { font-size: .75rem; padding: 5px 9px; border-radius: 999px; color: #cfc9ff; background: rgba(153,92,255,.13); border: 1px solid rgba(153,92,255,.2); }
    .service-icon { font-size: 1.8rem; color: var(--cyan); margin-bottom: 14px; }

    /* Education */
    .education-card { max-width: 760px; margin: auto; padding: 30px; display: flex; gap: 20px; align-items: flex-start; }
    .education-icon { flex: 0 0 55px; height: 55px; border-radius: 16px; display: grid; place-items: center; font-size: 1.5rem; color: var(--cyan); background: rgba(0,220,255,.12); }
    .education-card p { color: var(--muted); margin-top: 7px; }

    /* Contact and footer */
    .contact-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 22px; }
    .contact-info, .contact-form { padding: 28px; }
    .contact-info p { color: var(--muted); margin: 10px 0 22px; }
    .contact-item { padding: 13px 0; border-bottom: 1px solid var(--line); color: #dedaf0; overflow-wrap: anywhere; }
    .contact-form label { display: block; color: #dcd8ed; font-size: .88rem; margin: 12px 0 6px; }
    .contact-form input, .contact-form textarea {
      width: 100%; padding: 13px 14px; border-radius: 12px; color: white;
      background: rgba(5,5,18,.65); border: 1px solid var(--line); outline: none; resize: vertical;
      transition: border-color .25s, box-shadow .25s;
    }
    .contact-form input:focus, .contact-form textarea:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(0,220,255,.1); }
    .contact-form button { margin-top: 17px; }
    #form-message { color: var(--cyan); margin-top: 12px; font-size: .88rem; min-height: 1.4em; }
    footer { border-top: 1px solid var(--line); padding: 25px 0; text-align: center; color: #928da8; font-size: .86rem; }
    .back-top {
      position: fixed; right: 20px; bottom: 20px; width: 44px; height: 44px; border-radius: 50%;
      border: 1px solid rgba(0,220,255,.4); color: var(--cyan); background: rgba(15,15,34,.88);
      cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(10px); transition: .3s; z-index: 900;
    }
    .back-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .reveal { opacity: 0; transform: translateY(25px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    @media (max-width: 850px) {
      .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .orbit-wrap { min-height: 340px; }
      .skills-grid, .projects-grid, .services-grid { grid-template-columns: repeat(2,1fr); }
    }
    @media (max-width: 650px) {
      .section { padding: 75px 0; }
      nav { min-height: 68px; }
      .menu-toggle { display: block; }
      .nav-links {
        position: absolute; top: 68px; left: 0; right: 0; padding: 18px 5% 24px;
        display: none; flex-direction: column; align-items: flex-start; gap: 17px;
        background: rgba(9,9,20,.97); border-bottom: 1px solid var(--line);
      }
      .nav-links.open { display: flex; }
      .hero { padding-top: 115px; }
      .hero h1 { letter-spacing: -1px; }
      .orbit-wrap { min-height: 300px; }
      .orbit { width: 255px; }
      .orbit-core { width: 112px; height: 112px; font-size: 2.8rem; }
      .skills-grid, .projects-grid, .services-grid { grid-template-columns: 1fr; }
      .facts { grid-template-columns: 1fr 1fr; }
      .about-copy, .about-highlight, .contact-info, .contact-form { padding: 23px; }
      .education-card { padding: 22px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="container" aria-label="Main navigation">
      <a class="logo" href="#home">CAROLINE<span>.</span></a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open navigation menu" aria-expanded="false">☰</button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
